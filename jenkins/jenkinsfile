pipeline {
  agent any

  stages {

    /* =========================
       BACKEND TESTS + COVERAGE
       ========================= */
    stage('Unit Tests - Backend') {
      agent {
        docker {
          image 'golang:1.22'
          reuseNode true
        }
      }

      steps {
        dir('bugtracker-backend') {
          sh '''
            echo "Running backend tests..."
            go test -v ./...

            echo "Generating backend coverage..."
            go test ./... -coverprofile=coverage.out

            mkdir -p reports
            go tool cover -html=coverage.out -o reports/coverage.html
            ls -l reports
          '''
        }
      }

      post {
        always {
          publishHTML([
            reportDir: 'bugtracker-backend/reports',
            reportFiles: 'coverage.html',
            reportName: 'Backend Coverage Report',
            keepAll: true,
            alwaysLinkToLastBuild: true,
            allowMissing: false
          ])
        }
      }
    }

    /* =========================
       FRONTEND TESTS + COVERAGE
       ========================= */
    stage('Frontend Tests') {
      agent {
        docker {
          image 'node:20'
          reuseNode true
        }
      }

      steps {
        dir('bugtracker-frontend') {
          sh '''
            npm install
            npm test
            ls -l coverage/lcov-report
          '''
        }
      }

      post {
        always {
          publishHTML([
            reportDir: 'bugtracker-frontend/coverage/lcov-report',
            reportFiles: 'index.html',
            reportName: 'Frontend Coverage Report',
            keepAll: true,
            alwaysLinkToLastBuild: true,
            allowMissing: false
          ])
        }
      }
    }
  }
}
