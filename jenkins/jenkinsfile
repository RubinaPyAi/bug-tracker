pipeline {
  agent any

  stages {
    stage('unit tests - backend') {
      agent {
        docker {
          image 'golang:1.22'
          reuseNode true
        }
      }
      environment {
        GOCACHE = "${WORKSPACE}/.gocache"
      }
      steps {
        dir('bugtracker-backend') {
          sh 'go test -v ./...'
        }
      }
    }

stage('Frontend tests') {
      agent {
        docker {
          image 'node:20'
          reuseNode true
        }
      }
      steps {
        dir('bugtracker-frontend') {
          sh 'npm install'
          sh 'npm test'
        }
      }
      post {
        always {
          junit 'bugtracker-frontend/test-results.xml'
        }
      }
    }
  }
}
