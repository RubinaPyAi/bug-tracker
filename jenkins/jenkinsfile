pipeline {
  agent any

  stages {

    /* =========================
       BACKEND UNIT TESTS (GO)
       ========================= */
    stage('Unit Tests - Backend') {
      agent {
        docker {
          image 'golang:1.22'
          reuseNode true
        }
      }
      steps {
        dir('bugtracker-backend') {
          sh '''
            echo "Installing go-junit-report..."
            go install github.com/jstemmer/go-junit-report/v2@latest

            GO_JUNIT_BIN="$(go env GOPATH)/bin/go-junit-report"
            echo "Using go-junit-report at: $GO_JUNIT_BIN"

            echo "Running Go tests..."
            go test -v ./... 2>&1 | "$GO_JUNIT_BIN" > test-results.xml

            echo "Backend test report generated:"
            ls -l test-results.xml
          '''
        }
      }
      post {
        always {
          junit '**/test-results.xml'
        }
      }
    }

    /* =========================
       FRONTEND UNIT TESTS (JEST)
       ========================= */
    stage('Frontend Tests') {
      agent {
        docker {
          image 'node:20'
          reuseNode true
        }
      }
      steps {
        dir('bugtracker-frontend') {
          sh '''
            echo "Installing frontend dependencies..."
            npm install

            echo "Running frontend tests..."
            npm test

            echo "Frontend test report generated:"
            ls -l test-results.xml
          '''
        }
      }
      post {
        always {
          junit '**/test-results.xml'
        }
      }
    }

  }
}
